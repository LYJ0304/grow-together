{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly report Worker contract weekly-v1/v2",
  "$defs": {
    "ReportEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "TODO",
            "DIARY"
          ]
        },
        "id": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },
    "ReportObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportEvidence"
          },
          "maxItems": 5,
          "minItems": 1
        }
      }
    },
    "ReportNextStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "reason",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "maxLength": 240,
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportEvidence"
          },
          "maxItems": 5,
          "minItems": 1
        }
      }
    },
    "ReportDaily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "completed"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "completed": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        }
      }
    },
    "ReportInsightResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "observations",
        "nextSteps"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportObservation"
          },
          "maxItems": 3,
          "minItems": 1
        },
        "nextSteps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportNextStep"
          },
          "maxItems": 2,
          "minItems": 1
        }
      }
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "end_exclusive",
        "as_of",
        "current"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "end_exclusive": {
          "type": "string",
          "format": "date"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "eligible",
        "completed",
        "diary_days",
        "completion_rate",
        "daily"
      ],
      "properties": {
        "planned": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "diary_days": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "completion_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "daily": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportDaily"
          },
          "maxItems": 7
        }
      }
    },
    "Child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "age_months",
        "age_as_of",
        "concern_codes",
        "available_activity_time"
      ],
      "properties": {
        "age_months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72
        },
        "age_as_of": {
          "type": "string",
          "format": "date"
        },
        "concern_codes": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "sleep",
              "feeding",
              "emotion_expression",
              "communication",
              "developmental_play",
              "daily_habits",
              "separation_anxiety",
              "none"
            ]
          }
        },
        "available_activity_time": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "5min",
            "10min",
            "15to20min",
            "flexible",
            null
          ]
        }
      }
    },
    "Todo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "date",
        "time"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?$"
        },
        "child_reaction": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ENJOYED",
            "NEUTRAL",
            "DIFFICULT",
            null
          ],
          "default": null
        }
      }
    },
    "Diary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "excerpt"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        }
      }
    },
    "Sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "todos",
        "diaries",
        "todos_truncated"
      ],
      "properties": {
        "todos": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Todo"
          }
        },
        "diaries": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/Diary"
          }
        },
        "todos_truncated": {
          "type": "boolean"
        }
      }
    },
    "WorkerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "observations",
        "next_steps"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportObservation"
          },
          "maxItems": 3,
          "minItems": 1
        },
        "next_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportNextStep"
          },
          "maxItems": 2,
          "minItems": 1
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_hash",
        "prompt_version",
        "period",
        "metrics",
        "child_context",
        "sources"
      ],
      "properties": {
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_version": {
          "enum": [
            "weekly-v1",
            "weekly-v2"
          ]
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "child_context": {
          "$ref": "#/$defs/Child"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "prompt_version": {
                "const": "weekly-v1"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "properties": {
                  "todos": {
                    "items": {
                      "properties": {
                        "child_reaction": {
                          "type": "null"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_hash",
        "prompt_version",
        "result"
      ],
      "properties": {
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_version": {
          "enum": [
            "weekly-v1",
            "weekly-v2"
          ]
        },
        "result": {
          "$ref": "#/$defs/WorkerResult"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ]
}
