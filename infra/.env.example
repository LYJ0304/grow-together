POSTGRES_DB=growtogether
POSTGRES_USER=growtogether
POSTGRES_PASSWORD=local_dev_password

# Optional --profile rag only. Generate four different passwords; no defaults.
RAG_POSTGRES_PASSWORD=
RAG_READER_PASSWORD=
RAG_INGEST_PASSWORD=
RAG_MIGRATOR_PASSWORD=
# Reader only; percent-encode the password in this URL. Leave blank without RAG.
# postgresql://rag_reader:<encoded-password>@rag-postgres:5432/growtogether_rag
RAG_DATABASE_URL=
# Enable only after provisioning and corpus evaluation; existing chat is unaffected.
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_MIN_SIMILARITY=0.35
