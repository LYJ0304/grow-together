# Set to the selected main SHA before building.
STAGING_BUILD_TAG=local
STAGING_API_PORT=18080
STAGING_MINIO_PORT=19000
STAGING_STORAGE_URL=https://macbook.example.ts.net:9443

STAGING_POSTGRES_PASSWORD=
# Generate the JWT secret with openssl rand -base64 32.
STAGING_JWT_SECRET=
STAGING_WORKER_API_KEY=
STAGING_OPENROUTER_API_KEY=
STAGING_LLM_CHAT_MODEL=
STAGING_LLM_DIARY_MODEL=
STAGING_LLM_SCHEDULE_MODEL=
STAGING_LLM_REPORT_MODEL=

STAGING_MINIO_ROOT_USER=staging-root
STAGING_MINIO_ROOT_PASSWORD=
STAGING_MINIO_API_USER=staging-api
STAGING_MINIO_API_PASSWORD=

# Optional --profile rag only. Generate four different passwords; no defaults.
RAG_POSTGRES_PASSWORD=
RAG_READER_PASSWORD=
RAG_INGEST_PASSWORD=
RAG_MIGRATOR_PASSWORD=
# Reader only; percent-encode the password in this URL. Leave blank without RAG.
# postgresql://rag_reader:<encoded-password>@rag-postgres:5432/growtogether_rag
RAG_DATABASE_URL=
