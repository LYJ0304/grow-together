# development | staging | production; defaults to development.
EXPO_PUBLIC_APP_ENV=development
# Required for development and production. Optional for staging UI preview.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Unset/true enables preview in development and staging; false disables it.
# Production always disables preview, regardless of this setting.
EXPO_PUBLIC_ENABLE_AUTH_BYPASS=true
