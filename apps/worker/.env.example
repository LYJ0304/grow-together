SERVICE_NAME=growtogether-worker
LOG_LEVEL=INFO

AI_WORKER_API_KEY=input-your-key
OPENROUTER_API_KEY=input-your-key

LLM_DIARY_MODEL=
LLM_SCHEDULE_MODEL=
LLM_CHAT_MODEL=
LLM_REPORT_MODEL=

# Optional RAG reader connection; pool is created only with RAG_ENABLED=true.
# Docker Compose takes this value from infra/.env (or infra/staging/.env).
RAG_DATABASE_URL=
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_MIN_SIMILARITY=0.35
# Do not store the ingestion DSN here: export RAG_INGEST_DATABASE_URL only for the CLI.
