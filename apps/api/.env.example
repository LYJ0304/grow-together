SPRING_PROFILES_ACTIVE=local
# Used when running the API outside Docker; Compose supplies the database connection.
DATABASE_URL=jdbc:postgresql://localhost:5432/growtogether
POSTGRES_USER=growtogether
POSTGRES_PASSWORD=local_dev_password
# Required: generate with openssl rand -base64 32. Never commit the generated value.
JWT_SECRET=
JWT_ACCESS_TOKEN_SECONDS=900
JWT_REFRESH_SESSION_SECONDS=1209600
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006

# Private S3/R2 file storage. Disabled until bucket and runtime credentials are configured.
STORAGE_ENABLED=false
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# Optional S3-compatible endpoint. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; REGION=auto
STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false
STORAGE_URL_TTL_SECONDS=300
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_INTERVAL_MS=3600000
# AWS SDK default credentials chain (or workload IAM role); never commit actual keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary credential token
AWS_SESSION_TOKEN=
