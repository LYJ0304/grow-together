SPRING_PROFILES_ACTIVE=local
# Used when running the API outside Docker; Compose supplies the database connection.
DATABASE_URL=jdbc:postgresql://localhost:5432/growtogether
POSTGRES_USER=growtogether
POSTGRES_PASSWORD=local_dev_password
# Required: generate with openssl rand -base64 32. Never commit the generated value.
JWT_SECRET=
JWT_ACCESS_TOKEN_SECONDS=900
JWT_REFRESH_SESSION_SECONDS=1209600
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
